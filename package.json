{
  "name": "projectpulse-monorepo",
  "version": "1.0.0",
  "description": "Multi-tenant Student Project Management & Collaboration Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

