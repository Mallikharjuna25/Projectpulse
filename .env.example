# ==============================================================================
# PROJECTPULSE ROOT CONFIGURATION EXAMPLE
# ==============================================================================

# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/projectpulse

# Security & Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_encryption_secret_minimum_32_chars

# Email Configuration (Nodemailer - logs to console if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ProjectPulse <noreply@projectpulse.edu>"

# File Storage Configuration (default: local disk storage)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Cloudinary (Optional, active only if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Phase 2 GitHub Integration Flag (Disabled in Phase 1)
GITHUB_INTEGRATION_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_ENCRYPTION_KEY=32_bytes_hex_key_for_aes_256_encryption_at_rest

