PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/projectpulse

JWT_ACCESS_SECRET=projectpulse_access_secret_key_32_characters_minimum_length
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=projectpulse_refresh_secret_key_32_characters_minimum_length
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=projectpulse_cookie_secret_minimum_32_characters_long

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ProjectPulse <noreply@projectpulse.edu>"

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

GITHUB_INTEGRATION_ENABLED=false

